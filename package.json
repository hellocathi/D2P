{
  "name": "d2p",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown 驱动的医疗健康内容长页面系统",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspace @d2p/contracts && npm run build --workspace @d2p/markdown && vite build --config apps/web/vite.config.ts && tsup apps/server/src/index.ts --format esm --out-dir apps/server/dist --external express --external multer",
    "validate": "node --import tsx tools/validate.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "vite --config apps/web/vite.config.ts",
    "start": "node apps/server/dist/index.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "multer": "^2.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
